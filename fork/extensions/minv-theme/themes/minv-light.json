		"diffEditor.removedLineBackground": "#fde8e8",
		"diffEditor.insertedTextBackground": "#0d764333",
		"diffEditor.removedTextBackground": "#c22b2b33",
		"diffEditor.border": "#e8eaef",
		"diffEditorGutter.insertedLineBackground": "#e3f5ea",
		"diffEditorGutter.removedLineBackground": "#fde8e8",
		"scmGraph.historyItemHoverAdditionsForeground": "#0d7643",
		"scmGraph.historyItemHoverDeletionsForeground": "#c22b2b",
		"peekView.border": "#dcdfe6",
		"peekViewEditor.background": "#ffffff",
		"peekViewResult.background": "#eceef2",
		"peekViewTitle.background": "#f6f7f9",
		"progressBar.background": "#c8f135",
		"keybindingLabel.background": "#f6f7f9",
		"keybindingLabel.border": "#dcdfe6",
		"keybindingLabel.bottomBorder": "#dcdfe6",
		"keybindingLabel.foreground": "#4a505c",
		"welcomePage.background": "#ffffff"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#7f8592",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control",
				"keyword.operator.new",
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#6a3fd1"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#11744d"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#a85400"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#1f5ec4"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#0d0f12"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"meta.object-literal.key",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#2a2f38"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#5b6170"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#0d0f12",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#0d0f12",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#0d0f12",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#4a6800"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#0d7643"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#c22b2b"
			}
		},
		{
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#9c5c00"
			}
		}
	],
	"semanticHighlighting": false
}
