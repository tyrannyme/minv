		"editorIndentGuide.activeBackground1": "#dcdfe6",
		"editorWhitespace.foreground": "#dcdfe6",
		"editorBracketMatch.background": "#e3f5a6",
		"editorBracketMatch.border": "#00000000",
		"editorGutter.background": "#ffffff",
		"editorGutter.addedBackground": "#0d7643",
		"editorGutter.modifiedBackground": "#9c5c00",
