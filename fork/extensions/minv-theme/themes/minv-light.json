		"gitDecoration.deletedResourceForeground": "#c22b2b",
		"gitDecoration.untrackedResourceForeground": "#1a5fc2",
		"gitDecoration.conflictingResourceForeground": "#962bb3",
		"gitDecoration.ignoredResourceForeground": "#636977",
		"gitDecoration.submoduleResourceForeground": "#4a505c",
